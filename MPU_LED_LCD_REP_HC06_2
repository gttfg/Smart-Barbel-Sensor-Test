#include <MPU6050_tockn.h>
#include <Wire.h>
#include <Adafruit_NeoPixel.h>
#include <LiquidCrystal_I2C.h>
#include <SoftwareSerial.h>

#define LED_PIN 6
#define NUM_LEDS 8

SoftwareSerial bluetoothSerial(2, 3);
Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);
MPU6050 mpu6050(Wire);
LiquidCrystal_I2C lcd(0x27, 16, 2);

const unsigned long LED_INTERVAL = 50;
const unsigned long LCD_INTERVAL = 250;
const unsigned long BLUETOOTH_INTERVAL = 100;

unsigned long lastLEDTime = 0;
unsigned long lastLCDTime = 0;
unsigned long lastBluetoothTime = 0;
unsigned long lastRepTime = 0;

const uint32_t COLOR_BASE = strip.Color(0, 255, 0);
const uint32_t COLOR_Y_ONLY = strip.Color(255, 0, 0);
const uint32_t COLOR_Z_ONLY = strip.Color(255, 128, 0);
const uint32_t COLOR_BOTH = strip.Color(128, 0, 128);

const float ACCEL_DOWN_THRESHOLD = -0.3;
const float ACCEL_UP_THRESHOLD = 0.2;

int repCount = 0;
bool isDown = false;

void updateLEDs(float angleY, float angleZ) {
  const int halfDots = NUM_LEDS / 2;
  const float invAngleY = -angleY;

  for (int i = 0; i < NUM_LEDS; i++) {
    float targetY = (i < halfDots) ? (i - halfDots) * 3.0
                                     : (i - halfDots + 1) * 3.0;
    float targetZ = (i < halfDots) ? (i - halfDots) * 2.0
                                     : (i - halfDots + 1) * 2.0;

    bool yTilted = (invAngleY >= 1.5 && targetY > 0 && invAngleY >= targetY) ||
                   (invAngleY <= -1.5 && targetY < 0 && invAngleY <= targetY);
    bool zTilted = (angleZ >= 1.0 && targetZ > 0 && angleZ >= targetZ) ||
                   (angleZ <= -1.0 && targetZ < 0 && angleZ <= targetZ);

    uint32_t color = COLOR_BASE;
    if (yTilted && zTilted) color = COLOR_BOTH;
    else if (yTilted) color = COLOR_Y_ONLY;
    else if (zTilted) color = COLOR_Z_ONLY;

    strip.setPixelColor(i, color);
  }
  strip.show();
}

void showRepCount() {
  lcd.setCursor(0, 1);
  lcd.print("                ");
  lcd.setCursor(0, 1);
  lcd.print("REP: ");
  lcd.print(repCount);
}

void showAngles(float angleY, float angleZ) {
  // 각 영역만 지워 이전 숫자의 자릿수가 남지 않게 합니다.
  lcd.setCursor(0, 0);
  lcd.print("        ");
  lcd.setCursor(0, 0);
  lcd.print("Y:");
  lcd.print(-angleY, 1);

  lcd.setCursor(8, 0);
  lcd.print("        ");
  lcd.setCursor(8, 0);
  lcd.print("Z:");
  lcd.print(angleZ, 1);
}

void sendBluetoothTelemetry(float angleY, float angleZ) {
  bluetoothSerial.print("Y:");
  bluetoothSerial.print(-angleY, 1);
  bluetoothSerial.print(",Z:");
  bluetoothSerial.print(angleZ, 1);
  bluetoothSerial.print(",REP:");
  bluetoothSerial.println(repCount);
}

void setup() {
  Serial.begin(115200);
  Serial.println("BOOT");  // 화면이 꺼질 때 재부팅도 되는지 확인용
  bluetoothSerial.begin(9600);

  Wire.begin();
  Wire.setClock(100000);
#if defined(ARDUINO_ARCH_AVR)
  Wire.setWireTimeout(3000, true);
#endif

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Init System...");

  strip.begin();
  strip.setBrightness(20);
  strip.fill(COLOR_BASE, 0, NUM_LEDS);
  strip.show();

  mpu6050.begin();
  mpu6050.calcGyroOffsets(true);

  lcd.clear();  // 시작할 때만 사용
  showRepCount();
}

void loop() {
  mpu6050.update();
  unsigned long now = millis();

  float accY = mpu6050.getAccY();
  if (now - lastRepTime > 500) {
    if (!isDown && accY < ACCEL_DOWN_THRESHOLD) {
      isDown = true;
    } else if (isDown && accY > ACCEL_UP_THRESHOLD) {
      isDown = false;
      repCount++;
      lastRepTime = now;
      showRepCount();
      Serial.print("REP: ");
      Serial.println(repCount);
    }
  }

  float angleY = mpu6050.getAngleY();
  float angleZ = mpu6050.getAngleZ();
  if (isnan(angleY) || isnan(angleZ)) return;

  if (now - lastLEDTime >= LED_INTERVAL) {
    lastLEDTime = now;
    updateLEDs(angleY, angleZ);
  }

  if (now - lastLCDTime >= LCD_INTERVAL) {
    lastLCDTime = now;
    showAngles(angleY, angleZ);
  }

  if (now - lastBluetoothTime >= BLUETOOTH_INTERVAL) {
    lastBluetoothTime = now;
    sendBluetoothTelemetry(angleY, angleZ);
  }
}
